{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
