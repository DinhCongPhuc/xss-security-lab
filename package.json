{
  "name": "xss-security-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && npm run build -w @xss-lab/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "@xss-lab/shared-types": "*",
    "@xss-lab/test-cases": "*"
  },
  "dependencies": {
    "@xss-lab/api": "*",
    "@xss-lab/secure-lab": "*",
    "@xss-lab/vulnerable-lab": "*",
    "@xss-lab/shared-config": "*"
  }
}
